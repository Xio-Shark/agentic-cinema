# ==============================================================================
# Agentic Cinema: Environment Variables Configuration
# ==============================================================================

# 1. Google Gemini API Key (Obtain from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# 2. Grafana Cloud Configuration (From https://grafana.com/orgs/zealousherring1943)
# The full URL of your Grafana Cloud instance (e.g. https://<your-subdomain>.grafana.net)
GRAFANA_URL=
# Service Account Token generated in Grafana (Administration -> Users and access -> Service Accounts -> Add service account token)
GRAFANA_SERVICE_ACCOUNT_TOKEN=
